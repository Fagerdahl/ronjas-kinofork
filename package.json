{
  "name": "kino-scrum",
  "version": "1.0.0",
  "description": "Website for a local movie theater",
  "main": "index.js",
  "type": "module",
  
  "scripts": {
    "test": "jest",
    "start": "node express/server.js",
    "prepare": "husky install",
    "build-css": "sass src/styles/main.scss dist/styles.css",
    "watch-css": "sass --watch src/styles/main.scss:dist/styles.css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.11",
    "node-fetch": "^3.3.2",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "supertest": "^7.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,html}": [
      "prettier --write"
    ]
  }
}
